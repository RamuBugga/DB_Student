CREATE OR ALTER PROCEDURE USP_Get_FeeStructure_Filter
(
    @InstitutionID     INT,
    @CampusID          INT,
    @AcademicYearID    INT,
    @ClassStageID      INT,
    @SegmentID         INT = 0,        -- 0 or NULL = ALL segments
    @FeeTypeID         INT,
    @StudentType       VARCHAR(10)     -- 'New', 'Old', 'All'
)
AS
BEGIN
    SET NOCOUNT ON;

    ------------------------------------------------------
    -- Convert StudentType to Flags
    ------------------------------------------------------
    DECLARE @IsNew BIT = 0, @IsOld BIT = 0;

    IF (@StudentType = 'New' OR @StudentType = 'All')
        SET @IsNew = 1;

    IF (@StudentType = 'Old' OR @StudentType = 'All')
        SET @IsOld = 1;

    ------------------------------------------------------
    -- Clean SegmentID (NULL or 0 = ALL)
    ------------------------------------------------------
    SET @SegmentID = ISNULL(@SegmentID, 0);

    ------------------------------------------------------
    -- ALWAYS RETURN CLASS LIST + EXISTING FEESTRUCTURE
    ------------------------------------------------------
    SELECT 
        C.ClassID,
        C.ClassName,

        -- Existing FeeStructure (NULL if not present)
        FS.FeeStructureID,
        FS.Amount,
        FS.NoOfInstallments,
        FS.FeeTypeID,
        FS.StudentSegmentID,
        FS.IsNewStudents,
        FS.IsOldStudents

    FROM Classes C

    LEFT JOIN FeeStructure FS 
        ON FS.ClassID = C.ClassID
        AND FS.InstitutionID = @InstitutionID
        AND FS.CampusID = @CampusID
        AND FS.AcademicYearID = @AcademicYearID
        AND FS.FeeTypeID = @FeeTypeID
        AND FS.IsActive = 1
        
        AND (
                @SegmentID = 0
             OR FS.StudentSegmentID = @SegmentID
            )

        AND (
                (FS.IsNewStudents = 1 AND @IsNew = 1)
             OR (FS.IsOldStudents = 1 AND @IsOld = 1)
            )

    WHERE 
        C.InstitutionID = @InstitutionID
        AND C.CampusID = @CampusID

        -- Stage filter (0 = ALL)
        AND ( @ClassStageID = 0 OR C.ClassStageID = @ClassStageID )

        AND C.Status = 1

    ORDER BY C.SequenceNo, C.ClassName;

END
GO
