CREATE OR ALTER PROCEDURE USP_Get_FeeStructure_Filter
(
    @InstitutionID     INT,
    @CampusID          INT,
    @AcademicYearID    INT,
    @ClassStageID      INT,
    @SegmentID         INT = 0,        -- 0 = ALL segments
    @FeeTypeID         INT,
    @StudentType       VARCHAR(10)     -- 'New', 'Old', 'All'
)
AS
BEGIN
    SET NOCOUNT ON;

    ------------------------------------------------------
    -- Convert StudentType
    ------------------------------------------------------
    DECLARE @IsNew BIT = 0, @IsOld BIT = 0;

    IF (@StudentType = 'New' OR @StudentType = 'All')
        SET @IsNew = 1;

    IF (@StudentType = 'Old' OR @StudentType = 'All')
        SET @IsOld = 1;

    ------------------------------------------------------
    -- FIX DUPLICATES: SELECT ONLY 1 RECORD PER CLASS
    ------------------------------------------------------
    ;WITH Fee AS 
    (
        SELECT 
            FS.FeeStructureID,
            FS.ClassID,
            FS.Amount,
            FS.NoOfInstallments,
            FS.FeeTypeID,
            FS.StudentSegmentID,
            FS.IsNewStudents,
            FS.IsOldStudents,
            ROW_NUMBER() OVER (PARTITION BY FS.ClassID ORDER BY FS.FeeStructureID DESC) AS RN
        FROM FeeStructure FS
        WHERE 
            FS.InstitutionID = @InstitutionID
            AND FS.CampusID = @CampusID
            AND FS.AcademicYearID = @AcademicYearID
            AND FS.FeeTypeID = @FeeTypeID
            AND ( @SegmentID = 0 OR FS.StudentSegmentID = @SegmentID )
            AND FS.IsActive = 1
            AND (
                    (FS.IsNewStudents = @IsNew)
                 OR (FS.IsOldStudents = @IsOld)
                )
    )

    SELECT 
        C.ClassID,
        C.ClassName,

        -- Selected Fee Row
        F.FeeStructureID,
        F.Amount,
        F.NoOfInstallments,
        F.FeeTypeID,
        F.StudentSegmentID,
        F.IsNewStudents,
        F.IsOldStudents

    FROM Classes C
    LEFT JOIN Fee F ON F.ClassID = C.ClassID AND F.RN = 1  -- ✔ Only 1 row per class

    WHERE 
        C.InstitutionID = @InstitutionID
        AND C.CampusID = @CampusID
        AND C.ClassStageID = @ClassStageID
        AND C.Status = 1

    ORDER BY C.ClassName;
END
