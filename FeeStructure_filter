CREATE OR ALTER PROCEDURE USP_Get_FeeStructure_Filter
(
    @InstitutionID     INT,
    @CampusID          INT,
    @AcademicYearID    INT,
    @ClassStageID      INT,
    @SegmentID         INT = 0,        -- 0 = ALL segments
    @FeeTypeID         INT,
    @StudentType       VARCHAR(10)     -- 'New', 'Old', 'All'
)
AS
BEGIN
    SET NOCOUNT ON;

    ------------------------------------------------------
    -- Convert StudentType
    ------------------------------------------------------
    DECLARE @IsNew BIT = 0, @IsOld BIT = 0;

    IF (@StudentType = 'New' OR @StudentType = 'All')
        SET @IsNew = 1;

    IF (@StudentType = 'Old' OR @StudentType = 'All')
        SET @IsOld = 1;

    ------------------------------------------------------
    -- ALWAYS RETURN CLASS LIST + MATCHED FEESTRUCTURE
    ------------------------------------------------------
    SELECT 
        C.ClassID,
        C.ClassName,

        -- FeeStructure Columns (NULL if not available)
        FS.FeeStructureID,
        FS.Amount,
        FS.NoOfInstallments,
        FS.FeeTypeID,
        FS.StudentSegmentID,
        FS.IsNewStudents,
        FS.IsOldStudents

    FROM Classes C
    LEFT JOIN FeeStructure FS 
        ON FS.ClassID = C.ClassID
        AND FS.InstitutionID = @InstitutionID
        AND FS.CampusID = @CampusID
        AND FS.AcademicYearID = @AcademicYearID
        AND FS.FeeTypeID = @FeeTypeID
        AND ( @SegmentID = 0 OR FS.StudentSegmentID = @SegmentID )
        AND FS.IsActive = 1
        AND (
                (FS.IsNewStudents = @IsNew)
             OR (FS.IsOldStudents = @IsOld)
            )

    WHERE 
        C.InstitutionID = @InstitutionID
        AND C.CampusID = @CampusID
        AND C.ClassStageID = @ClassStageID
        AND C.Status = 1

    ORDER BY C.ClassName;
END
